// REVIEW ONLY — candidate insertion inside existing match /groups/{groupId}.
// Do NOT deploy without merging into the currently deployed Firestore rules,
// emulator authorization/denial tests, and owner approval.
// Existing canViewGroup(groupId) must require ACTIVE membership.
match /orders/{orderId} {
  function orderPath() {
    return /databases/$(database)/documents/groups/$(groupId)/orders/$(orderId);
  }
  function auditPath(auditId) {
    return /databases/$(database)/documents/groups/$(groupId)/orders/$(orderId)/history/$(auditId);
  }
  function lineValid(line) {
    return line is map
      && line.keys().hasAll(['productName','specification','quantity','unit','arrivedQuantity'])
      && line.keys().hasOnly(['productName','specification','quantity','unit','arrivedQuantity'])
      && line.productName is string && line.productName.size()>0 && line.productName.size()<=120
      && line.specification is string && line.specification.size()<=200
      && line.unit is string && line.unit.size()>0 && line.unit.size()<=20
      && line.quantity is number && line.quantity>0
      && line.arrivedQuantity is number && line.arrivedQuantity>=0
      && line.arrivedQuantity<=line.quantity;
  }
  function extraLinesValid(d) {
    return !d.keys().hasAny(['lineItems']) || (d.lineItems is list && d.lineItems.size()<=9
      && (d.lineItems.size()<=0 || lineValid(d.lineItems[0]))
      && (d.lineItems.size()<=1 || lineValid(d.lineItems[1]))
      && (d.lineItems.size()<=2 || lineValid(d.lineItems[2]))
      && (d.lineItems.size()<=3 || lineValid(d.lineItems[3]))
      && (d.lineItems.size()<=4 || lineValid(d.lineItems[4]))
      && (d.lineItems.size()<=5 || lineValid(d.lineItems[5]))
      && (d.lineItems.size()<=6 || lineValid(d.lineItems[6]))
      && (d.lineItems.size()<=7 || lineValid(d.lineItems[7]))
      && (d.lineItems.size()<=8 || lineValid(d.lineItems[8])));
  }
  function noArrival(d) {
    let lines=d.get('lineItems',[]);
    return d.arrivedQuantity==0 && (!d.keys().hasAny(['lineItems']) || ((lines.size()<=0 || lines[0].arrivedQuantity==0) && (lines.size()<=1 || lines[1].arrivedQuantity==0) && (lines.size()<=2 || lines[2].arrivedQuantity==0) && (lines.size()<=3 || lines[3].arrivedQuantity==0) && (lines.size()<=4 || lines[4].arrivedQuantity==0) && (lines.size()<=5 || lines[5].arrivedQuantity==0) && (lines.size()<=6 || lines[6].arrivedQuantity==0) && (lines.size()<=7 || lines[7].arrivedQuantity==0) && (lines.size()<=8 || lines[8].arrivedQuantity==0)));
  }
  function fullyArrived(d) {
    let lines=d.get('lineItems',[]);
    return d.arrivedQuantity==d.quantity && (!d.keys().hasAny(['lineItems']) || ((lines.size()<=0 || lines[0].arrivedQuantity==lines[0].quantity) && (lines.size()<=1 || lines[1].arrivedQuantity==lines[1].quantity) && (lines.size()<=2 || lines[2].arrivedQuantity==lines[2].quantity) && (lines.size()<=3 || lines[3].arrivedQuantity==lines[3].quantity) && (lines.size()<=4 || lines[4].arrivedQuantity==lines[4].quantity) && (lines.size()<=5 || lines[5].arrivedQuantity==lines[5].quantity) && (lines.size()<=6 || lines[6].arrivedQuantity==lines[6].quantity) && (lines.size()<=7 || lines[7].arrivedQuantity==lines[7].quantity) && (lines.size()<=8 || lines[8].arrivedQuantity==lines[8].quantity)));
  }
  function fieldsValid(d) {
    return d is map
      && d.keys().hasAll(['productName','specification','quantity','unit','supplierName',
        'requesterUid','orderedByUid','orderDate','dueDate','arrivedQuantity','status','note'])
      && d.keys().hasOnly(['productName','specification','quantity','unit','supplierName',
        'requesterUid','orderedByUid','orderDate','dueDate','arrivedQuantity','status','note','lineItems'])
      && extraLinesValid(d)
      && d.productName is string && d.productName.size()>0 && d.productName.size()<=120
      && d.specification is string && d.specification.size()<=200
      && d.supplierName is string && d.supplierName.size()>0 && d.supplierName.size()<=120
      && d.unit is string && d.unit.size()>0 && d.unit.size()<=20
      && d.quantity is number && d.quantity>0
      && d.arrivedQuantity is number && d.arrivedQuantity>=0 && d.arrivedQuantity<=d.quantity
      && d.note is string && d.note.size()<=2000
      && d.requesterUid is string && d.requesterUid.size()<=150
      && d.orderedByUid is string && d.orderedByUid.size()<=150
      && d.orderDate is string && d.orderDate.size()<=10
      && (d.orderDate=='' || d.orderDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
      && d.dueDate is string && d.dueDate.size()<=10
      && (d.dueDate=='' || d.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
      && d.status in ['PENDING','ORDERED','PARTIAL','RECEIVED']
      && (d.status!='RECEIVED' || fullyArrived(d))
      && (d.status!='PARTIAL' || (!noArrival(d) && !fullyArrived(d)))
      && (!(d.status in ['PENDING','ORDERED']) || noArrival(d))
      && (d.status=='PENDING' || (d.orderDate!='' && d.orderedByUid.size()>0))
      && (d.status!='PENDING' || (d.orderDate=='' && d.orderedByUid==''));
  }
  function auditMatches(order,prior,kind) {
    return order.lastAuditId is string
      && existsAfter(auditPath(order.lastAuditId))
      && getAfter(auditPath(order.lastAuditId)).data.orderId==orderId
      && getAfter(auditPath(order.lastAuditId)).data.revision==order.revision
      && getAfter(auditPath(order.lastAuditId)).data.actorUid==request.auth.uid
      && getAfter(auditPath(order.lastAuditId)).data.changedAt==request.time
      && getAfter(auditPath(order.lastAuditId)).data.kind==kind
      && getAfter(auditPath(order.lastAuditId)).data.before==prior
      && getAfter(auditPath(order.lastAuditId)).data.after==order.details;
  }
  allow get,list: if canViewGroup(groupId);
  allow create: if canViewGroup(groupId)
    && request.resource.data.keys().hasOnly(['details','isCompleted','revision','createdBy','createdAt',
      'updatedBy','updatedAt','lastAuditId'])
    && request.resource.data.keys().hasAll(['details','isCompleted','revision','createdBy','createdAt',
      'updatedBy','updatedAt','lastAuditId'])
    && fieldsValid(request.resource.data.details)
    && request.resource.data.details.requesterUid==request.auth.uid
    && (request.resource.data.details.orderedByUid=='' || request.resource.data.details.orderedByUid==request.auth.uid)
    && request.resource.data.isCompleted==(request.resource.data.details.status=='RECEIVED')
    && request.resource.data.revision==1
    && request.resource.data.createdBy==request.auth.uid
    && request.resource.data.updatedBy==request.auth.uid
    && request.resource.data.createdAt==request.time
    && request.resource.data.updatedAt==request.time
    && auditMatches(request.resource.data,{},'CREATE');
  allow update: if canViewGroup(groupId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
      ['details','isCompleted','revision','updatedBy','updatedAt','lastAuditId'])
    && fieldsValid(request.resource.data.details)
    && request.resource.data.details!=resource.data.details
    && request.resource.data.details.requesterUid==resource.data.details.requesterUid
    && (request.resource.data.details.orderedByUid==resource.data.details.orderedByUid
      || request.resource.data.details.orderedByUid==''
      || (resource.data.details.orderedByUid==''
        && request.resource.data.details.orderedByUid==request.auth.uid))
    && request.resource.data.isCompleted==(request.resource.data.details.status=='RECEIVED')
    && request.resource.data.revision==resource.data.revision+1
    && request.resource.data.updatedBy==request.auth.uid
    && request.resource.data.updatedAt==request.time
    && request.resource.data.lastAuditId!=resource.data.lastAuditId
    && auditMatches(request.resource.data,resource.data.details,'UPDATE');
  allow delete: if false;
  match /history/{historyId} {
    allow get,list: if canViewGroup(groupId);
    allow create: if canViewGroup(groupId)
      && request.resource.data.keys().hasAll(['orderId','revision','actorUid','changedAt',
        'kind','before','after'])
      && request.resource.data.keys().hasOnly(['orderId','revision','actorUid','changedAt',
        'kind','before','after'])
      && request.resource.data.orderId==orderId
      && request.resource.data.actorUid==request.auth.uid
      && request.resource.data.changedAt==request.time
      && request.resource.data.kind in ['CREATE','UPDATE']
      && getAfter(orderPath()).data.lastAuditId==historyId
      && getAfter(orderPath()).data.revision==request.resource.data.revision
      && getAfter(orderPath()).data.details==request.resource.data.after
      && (
        (request.resource.data.kind=='CREATE'
          && !exists(orderPath())
          && request.resource.data.revision==1
          && request.resource.data.before=={})
        ||
        (request.resource.data.kind=='UPDATE'
          && exists(orderPath())
          && request.resource.data.revision==get(orderPath()).data.revision+1
          && request.resource.data.before==get(orderPath()).data.details)
      );
    allow update,delete: if false;
  }
}

