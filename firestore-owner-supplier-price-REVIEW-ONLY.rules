    // Supplier purchase prices are isolated from group notes and all other CRM data.
    match /ownerSupplierPrices/{ownerUid}/entries/{entryId} {
      allow get, list: if accountOwner() && request.auth.uid == ownerUid
        && request.auth.token.email == 'honbin002@gmail.com';
      allow create, update: if accountOwner() && request.auth.uid == ownerUid
        && request.auth.token.email == 'honbin002@gmail.com'
        && entryId.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly([
          'supplierName','partNo','productName','unit','price','sourceFileId','updatedAt'])
        && request.resource.data.keys().hasAll([
          'supplierName','partNo','productName','unit','price','sourceFileId','updatedAt'])
        && request.resource.data.supplierName is string
        && request.resource.data.supplierName.size() >= 1
        && request.resource.data.supplierName.size() <= 200
        && request.resource.data.partNo is string
        && request.resource.data.partNo.size() >= 1
        && request.resource.data.partNo.size() <= 120
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 200
        && request.resource.data.unit is string
        && request.resource.data.unit.size() <= 30
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 1000000000
        && request.resource.data.sourceFileId is string
        && request.resource.data.sourceFileId.size() >= 1
        && request.resource.data.sourceFileId.size() <= 150
        && request.resource.data.updatedAt == request.time;
      allow delete: if accountOwner() && request.auth.uid == ownerUid
        && request.auth.token.email == 'honbin002@gmail.com';
    }
