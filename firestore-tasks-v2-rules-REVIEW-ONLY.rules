// REVIEW ONLY - NOT DEPLOYED. TEST project: honbin-crm-notes-spark.
// This file is a fragment, NOT a complete Firestore rule set.
// Do not paste this file over deployed rules. Preserve existing V4D notes,
// owner allowlist, account approvals, invitations and cleanup rules.
// Merge only after CURRENT deployed rules readback, diff, syntax testing,
// and explicit authorization. No rule from this file is live yet.
//
// Add at database-root level, inside match /databases/{database}/documents:
match /profiles/{profileUid} {
  // No profile collection listing or arbitrary writes.
  // An already approved account may read a known UID's public nickname.
  allow get: if googleUser();
  allow list: if false;
  allow create: if googleUser()
    && request.auth.uid == profileUid
    && request.resource.data.keys().hasAll(['nickname','updatedAt'])
    && request.resource.data.keys().hasOnly(['nickname','updatedAt'])
    && request.resource.data.nickname is string
    && request.resource.data.nickname.size() >= 1
    && request.resource.data.nickname.size() <= 24
    && request.resource.data.updatedAt == request.time;
  allow update: if googleUser()
    && request.auth.uid == profileUid
    && request.resource.data.keys().hasAll(['nickname','updatedAt'])
    && request.resource.data.keys().hasOnly(['nickname','updatedAt'])
    && request.resource.data.nickname is string
    && request.resource.data.nickname.size() >= 1
    && request.resource.data.nickname.size() <= 24
    && request.resource.data.updatedAt == request.time
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['nickname','updatedAt']);
  allow delete: if false;
}

// Add ONLY inside existing match /groups/{groupId}, next to /notes/{noteId}.
match /tasks/{taskId} {
  allow get, list: if canViewGroup(groupId);
  // OWNER or ADMIN/EDITOR may publish. VIEWER may never publish.
  allow create: if canEditGroup(groupId)
    && request.resource.data.keys().hasAll([
      'title','description','assignedUid','executeDate','dueDate','status',
      'createdBy','createdAt','completedBy','completedAt','completionReply'
    ])
    && request.resource.data.keys().hasOnly([
      'title','description','assignedUid','executeDate','dueDate','status',
      'createdBy','createdAt','completedBy','completedAt','completionReply'
    ])
    && request.resource.data.title is string
    && request.resource.data.title.size() >= 1
    && request.resource.data.title.size() <= 120
    && request.resource.data.description is string
    && request.resource.data.description.size() <= 3000
    && request.resource.data.executeDate is string
    && request.resource.data.executeDate.size() <= 10
    && (request.resource.data.executeDate == ''
      || request.resource.data.executeDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
    && request.resource.data.dueDate is string
    && request.resource.data.dueDate.size() <= 10
    && (request.resource.data.dueDate == ''
      || request.resource.data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
    && (request.resource.data.assignedUid == null
      || (request.resource.data.assignedUid is string
        && (request.resource.data.assignedUid
            == get(groupPath(groupId)).data.ownerUid
          || (exists(memberPath(groupId, request.resource.data.assignedUid))
            && get(memberPath(groupId, request.resource.data.assignedUid)).data.status == 'ACTIVE'))))
    && request.resource.data.status == 'OPEN'
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time
    && request.resource.data.completedBy == null
    && request.resource.data.completedAt == null
    && request.resource.data.completionReply == '';

  // All ACTIVE members, including VIEWER, may complete ONLY an assigned-to-
  // them or unassigned task. One transition OPEN->DONE; no second overwrite.
  // Original task fields and assignee must remain immutable.
  allow update: if canViewGroup(groupId)
    && resource.data.status == 'OPEN'
    && (resource.data.assignedUid == null
      || resource.data.assignedUid == request.auth.uid)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'status','completedBy','completedAt','completionReply'
    ])
    && request.resource.data.status == 'DONE'
    && request.resource.data.completedBy == request.auth.uid
    && request.resource.data.completedAt == request.time
    && request.resource.data.completionReply is string
    && request.resource.data.completionReply.size() >= 1
    && request.resource.data.completionReply.size() <= 3000;
  allow delete: if false;
}

// REVIEW / SERVER-TEST GATE BEFORE ENABLING:
// 1. Owner and EDITOR can create tasks; VIEWER cannot create tasks or notes.
// 2. VIEWER can complete assigned-to-self or unassigned task, not others.
// 3. Completion is immutable and server timestamp equals request.time.
// 4. Only ACTIVE group members can read/complete, not revoked/nonmembers.
// 5. A user can create/edit only their own public nickname profile.
// 6. Unknown profile IDs cannot be enumerated.
// 7. Existing V4D group cleanup must inventory tasks before root deletion.
// 8. Preserve existing Firestore approvals and notes Rules with zero diffs.
// 9. Explicit owner approval + server rejection tests required before live UI.
